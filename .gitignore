# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local SQLite store (sessions, audit log)
/.data
.data/
data/
private/

# Working media (captures, video, Playwright output). The subset published in
# docs/assets/media/ is versioned; the raw material is not.
/dev-tools/media/out/
/dev-tools/media/node_modules/
/dev-tools/media/package-lock.json
