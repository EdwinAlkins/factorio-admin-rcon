# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local SQLite store (sessions, audit log)
/.data
.data/
# Factorio's own data, at the root only: source folders named `data`
# (src/server/data, services/agents/internal/data) are code.
/data/
private/
# Agent tokens (generated by setup-admin.sh), save archives, generated worlds
/secrets/
/backups/
/worlds/

# Working media (captures, video, Playwright output). The subset published in
# docs/assets/media/ is versioned; the raw material is not.
/dev-tools/media/out/
/dev-tools/media/node_modules/
/dev-tools/media/package-lock.json

# Local Graphify knowledge graph and generated reports, and what
# `graphify hook install` / `graphify claude install` add to the working tree.
# .gitattributes is versioned (Git LFS rules): keep graphify's own merge rule
# in .git/info/attributes, which git reads the same way and never commits.
graphify-out/
/.claude/
/CLAUDE.local.md
