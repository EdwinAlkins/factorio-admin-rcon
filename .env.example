# Copy to .env.local for development (`npm run dev`).
# In production these values come from docker-compose.yml.

# --- Accounts ----------------------------------------------------------------
# One password per role. No password at all = no account: the panel starts but
# refuses every login.
#   admin     : everything, including the raw RCON console and the audit log
#   moderator : info + moderation (kick, ban, mute, chat)
#   viewer    : read only (players, version, seed…)
ADMIN_PASSWORD=change-me
# MODERATOR_PASSWORD=
# VIEWER_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# Signing key for the session cookie. REQUIRED, 32 characters minimum, and
# independent from the passwords so rotating one does not sign everybody out.
# `./setup-admin.sh` generates it; by hand: `openssl rand -hex 32`.
# Deliberately left empty here: the panel refuses to run until you set it.
SESSION_SECRET=

# Development only: hosts allowed to load next dev resources (HMR). Needed when
# you open the panel from another machine, e.g. NEXT_DEV_ORIGINS=192.168.1.17
# NEXT_DEV_ORIGINS=
# SESSION_TTL_HOURS=12
# auto = `secure` cookie as soon as the request arrives over HTTPS. true forces it.
# COOKIE_SECURE=auto
# Only enable behind a reverse proxy you trust: the panel then starts believing
# X-Forwarded-For for per-IP rate limiting.
# TRUST_PROXY=false

# --- Factorio server ---------------------------------------------------------
# Under docker-compose, RCON_HOST=factorio (the service name) — reached over the
# compose network, with nothing published on the host.
# In development on the host, 127.0.0.1 — requires uncommenting the loopback
# RCON mapping in docker-compose.yml, which is off by default on purpose.
RCON_HOST=127.0.0.1
RCON_PORT=27015
# RCON password: directly, or through the file the Factorio image generates on
# its first start. RCON_PASSWORD takes precedence.
# RCON_PASSWORD=
RCON_PASSWORD_FILE=./data/config/rconpw
# Catalogue of custom commands (see README). Absent file = feature off.
# In production the compose file already mounts ./data/config on /factorio-config.
CUSTOM_COMMANDS_FILE=./data/config/commands.json
# RCON_TIMEOUT_MS=5000
# Maximum number of queued commands before refusing (503).
# RCON_MAX_QUEUE=20
# Commands per minute, per session.
# RCON_MAX_PER_MINUTE=60
# Status cache lifetime, in milliseconds.
# STATUS_CACHE_MS=5000

# --- Local storage (sessions + audit + metrics, SQLite) -----------------------
DATA_DIR=./.data
# AUDIT_RETENTION_DAYS=90
# Keep raw console commands verbatim in the audit log. Off by default: a command
# typed there may carry a token, and the log would be a second place it lives on.
# AUDIT_FULL_COMMANDS=false

# --- Metrics -----------------------------------------------------------------
# Master switch. false = the whole feature is off: no collector, no Statistics
# tab, no /api/metrics endpoint, nothing written to the database. The two source
# flags below are then not even read. Already-collected rows are kept, so
# turning it back on restores the history.
# METRICS_ENABLED=true
#
#   Source 1 — CPU and memory, read from the control agent (see "Server
#   control" below). Set to false when there is no agent to talk to: the panel
#   then keeps only the RCON-based metrics instead of retrying — and logging —
#   every interval.
#   METRICS_DOCKER=true
#
#   Source 2 — UPS, further down (METRICS_UPS).
# One sample every 15 s over 7 days is roughly 40 000 rows, about 2 MB.
# METRICS_INTERVAL_MS=15000
# METRICS_RETENTION_DAYS=7
#   Source 2 — UPS, measured with a Lua command (/silent-command). Harmless on a
#   dedicated server — multiplayer already disables achievements — but set to
#   false to skip it.
# METRICS_UPS=true

# --- Server control ----------------------------------------------------------
# Start, stop, restart and logs of the Factorio container, through the control
# agent (services/agents, cmd/control-agent) — the only component that mounts the Docker
# socket. false = no Server tab, no /api/server endpoints. Container metrics
# keep using the agent unless METRICS_DOCKER=false.
# CONTROL_ENABLED=true
# In development on the host, run the agent yourself and point at it.
# CONTROL_AGENT_URL=http://control-agent:8080
# Token shared with the agent. Prefer the file (a Compose secret): a variable
# shows up in `docker inspect`. ./setup-admin.sh generates ./secrets/control-agent-token.
# CONTROL_AGENT_TOKEN_FILE=/run/secrets/control_agent_token
# CONTROL_AGENT_TOKEN=
# Deadline of a read (status, CPU/memory, logs). Start/stop/restart have their
# own, much longer one: they last as long as Factorio takes to quit.
# CONTROL_AGENT_TIMEOUT_MS=10000
# How long a stop waits for Factorio to finish the save it was asked for.
# CONTROL_SAVE_TIMEOUT_MS=120000

# --- Saves ------------------------------------------------------------------------
# Archives, downloads, restores and scheduled backups, through the data agent
# (services/agents, cmd/data-agent) — the only component writing the game's
# files, and one that never sees the Docker socket. false = no Saves tab, no
# /api/saves endpoints, no scheduler. The schedule itself is set in the panel.
# SAVES_ENABLED=true
# DATA_AGENT_URL=http://data-agent:8080
# Distinct from the control agent's token. ./setup-admin.sh generates
# ./secrets/data-agent-token.
# DATA_AGENT_TOKEN_FILE=/run/secrets/data_agent_token
# DATA_AGENT_TOKEN=
# Deadline of a listing; archiving and restoring have their own, longer one.
# DATA_AGENT_TIMEOUT_MS=10000

# --- Mods -------------------------------------------------------------------------
# Installed list, updates, portal search and install, through the same data
# agent — the only component that reaches the Internet, and only the official
# mod portal. Changes are applied as one operation with a single restart, an
# archive of the map first, and a rollback if the server does not come back.
# false = no Mods tab, no /api/mods endpoints.
# Searching and installing need factorio.com credentials in
# ./secrets/factorio-portal — a file next to docker-compose.yml, not a variable
# of this .env — as {"username": "...", "token": "..."} (token: your
# factorio.com profile), then `docker compose up -d --force-recreate data-agent`.
# Without them the tab still lists, enables, disables and removes mods.
# MODS_ENABLED=true
# Bound on one mod download (data agent, read by docker-compose.yml).
# MODS_MAX_DOWNLOAD_MB=200
# Bound on a save uploaded from the Saves tab (data agent, read by
# docker-compose.yml). Uploads go in 8 MB requests: behind nginx, raise
# client_max_body_size to 10m.
# SAVES_MAX_UPLOAD_MB=2048

# --- Compose only (read by docker-compose.yml, not by the panel) ---------------
# Group owning the Docker socket on the host; ./setup-admin.sh fills it in.
# DOCKER_GID=
# Socket path on the host, if not the default (rootless Docker, for instance).
# DOCKER_SOCKET=/var/run/docker.sock
# Grace period Docker gives Factorio between SIGTERM and SIGKILL (10 to 300).
# STOP_TIMEOUT_SECONDS=60
# Save name restores write, only for a server started with a fixed SAVE_NAME
# (LOAD_LATEST_SAVE=false), e.g. my-map.zip.
# TARGET_SAVE_NAME=

# --- Misc --------------------------------------------------------------------
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_GLOBAL_MAX_ATTEMPTS=50
# LOG_LEVEL=info
