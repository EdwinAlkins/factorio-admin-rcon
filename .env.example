# Copier en .env.local pour le développement (`npm run dev`).
# En production, ces valeurs viennent de docker-compose.yml.

# --- Comptes -----------------------------------------------------------------
# Un mot de passe par rôle. Aucun mot de passe = aucun compte : le panneau
# démarre mais refuse toute connexion.
#   admin     : tout, y compris la console RCON brute et le journal d'audit
#   moderator : infos + modération (kick, ban, mute, chat)
#   viewer    : lecture seule (joueurs, version, seed…)
ADMIN_PASSWORD=change-moi
# MODERATOR_PASSWORD=
# VIEWER_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# Clé de signature du cookie de session (32 caractères minimum recommandés).
# Optionnelle : par défaut dérivée des mots de passe configurés, ce qui invalide
# les sessions quand un mot de passe change. `openssl rand -hex 32`.
# SESSION_SECRET=
# SESSION_TTL_HOURS=12
# auto = cookie `secure` dès que la requête arrive en HTTPS. true pour forcer.
# COOKIE_SECURE=auto
# N'activer que derrière un reverse proxy de confiance : le panneau se met alors
# à croire X-Forwarded-For pour la limitation par IP.
# TRUST_PROXY=false

# --- Serveur Factorio --------------------------------------------------------
# Dans docker-compose, RCON_HOST=factorio (nom du service).
# En dev sur l'hôte, 127.0.0.1 avec le port 27015 publié par le conteneur.
RCON_HOST=127.0.0.1
RCON_PORT=27015
# Mot de passe RCON : directement, ou via le fichier généré par
# docker-entrypoint.sh. RCON_PASSWORD a la priorité.
# RCON_PASSWORD=
RCON_PASSWORD_FILE=../data/config/rconpw
# RCON_TIMEOUT_MS=5000
# Nombre maximal de commandes en attente avant refus (503).
# RCON_MAX_QUEUE=20
# Commandes par minute et par session.
# RCON_MAX_PER_MINUTE=60
# Durée de vie du cache de statut, en millisecondes.
# STATUS_CACHE_MS=5000

# --- Stockage local (sessions + audit, SQLite) -------------------------------
DATA_DIR=./.data
# AUDIT_RETENTION_DAYS=90

# --- Divers ------------------------------------------------------------------
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_GLOBAL_MAX_ATTEMPTS=50
# LOG_LEVEL=info
